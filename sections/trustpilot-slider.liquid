{% if shop.metaobjects.trustpilot_reviews.values.count > 0  %}

{% style %}
  .{{ section.id }}{
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-top: {{ section.settings.padding_top }}px;
  }
  @media (max-width:749px){
    .{{ section.id }}{
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      padding-top: {{ section.settings.padding_top_mobile }}px;
    }
  }
  .ns-trustpilot-slider .ns-trustpilot-content{
    display: flex;
    align-items: center;
    gap: 30px;
    flex-wrap: wrap;
  }
  .ns-trustpilot-slider .ns-trustpilot-left{
    width: 20%;
    text-align: center;
  }
  .ns-trustpilot-slider .ns-trustpilot-right{
    width: calc(80% - 30px);
  }
  .ns-trustpilot-slider .ns-trustpilot-reviews-slide{
    width: calc(100% / {{ section.settings.desktop_slide }} );
    padding: 0 10px;
  }
  .ns-trustpilot-slider .ns-trustpilot-stars img{ height: 20px; width: auto; }
  .ns-trustpilot-slider .ns-trustpilot-logo img{ height: 40px; width: auto; }
  .ns-trustpilot-slider .name{ font-weight: 600; margin-bottom: 10px; }
  .ns-trustpilot-slider .author{ margin-top: 10px; font-weight: 600; }

  .modal-content .ns-trustpilot-stars img{ height: 20px; width: auto; }
  .modal-content .ns-trustpilot-logo img{ height: 40px; width: auto; }
  .modal-content .name{ font-weight: 600; margin-bottom: 10px; }
  .modal-content .author{ margin-top: 10px; font-weight: 600; }
  
  .ns-trustpilot-slider .progress-bar-container{
    background: #eee;
    margin: 5px 0 0;
  }
  .ns-trustpilot-slider .progress-bar-container .progress-bar{
    background: #000
  }
  .ns-trustpilot-slider .flickity-prev-next-button{
    width:30px;
    height: 30px;
    border: 1px solid;
  }
  .ns-trustpilot-slider .flickity-prev-next-button.next {
    right: -32px;
  }
  .ns-trustpilot-slider .flickity-prev-next-button.previous {
    left: -32px;
  }

  @media (max-width:767px){
    .ns-trustpilot-slider .ns-trustpilot-left{
      width: 100%;
    }
    .ns-trustpilot-slider .ns-trustpilot-right{
      width: 100%;
    }
    .ns-trustpilot-slider .ns-trustpilot-reviews-slide{
      width: calc(100% / {{ section.settings.mobile_slide }} );
    }
    .ns-trustpilot-slider .flickity-prev-next-button.next {
      right: -10px;
    }
    .ns-trustpilot-slider .flickity-prev-next-button.previous {
      left: -10px;
    }
    .ns-trustpilot-slider .flickity-prev-next-button{
      display: none;
    }
    .ns-trustpilot-slider .author{
      margin-top: 10px;
    }
  }
  .ns-trustpilot-reviews-slider {
    opacity: 0;
    transition: opacity 1s ease; /* smooth fade-in */
    overflow: hidden;              /* prevent stacked slides from showing */
  }

  /* Show the slider when Flickity is ready */
  .ns-trustpilot-reviews-slider.flickity-enabled {
    opacity: 1;
  }
{% endstyle %}






  <div class="index-section color-{{ section.settings.color_scheme }} {{ section.id }}">
  <div class="page-width">
    <section id="ns-trustpilot-reviews-{{ section.id }}" class="ns-trustpilot-slider">
      <div class="ns-trustpilot-wrapper">
        {% if section.settings.image %}
          <div class="ns-trustpilot-image">
            {{ section.settings.image | image_url: width: section.settings.image.width | image_tag: loading: 'lazy' }}
          </div>
        {% endif %}
        <div class="ns-trustpilot-content">
          <div class="ns-trustpilot-left">
            {% if section.settings.heading != '' %}
              <h2 class="ns-trustpilot-heading">{{ section.settings.heading }}</h2>
            {% endif %}
            {% if section.settings.trustpilot_stars %}
              <div class="ns-trustpilot-stars">
                {% if section.settings.trustpilot_link != blank %}
                  <a target="_blank" href="{{ section.settings.trustpilot_link }}">
                {% endif %}
                {{ section.settings.trustpilot_stars | image_url: width: section.settings.trustpilot_stars.width | image_tag: loading: 'lazy' }}
                {% if section.settings.trustpilot_link != blank %}
                  </a>
                {% endif %}
              </div>
            {% endif %}
            {% if section.settings.trustpilot_text %}
              <div class="ns-trustpilot-text">
                {% if section.settings.trustpilot_link != blank %}
                  <a target="_blank" href="{{ section.settings.trustpilot_link }}">
                {% endif %}
                  {{ section.settings.trustpilot_text }}
                {% if section.settings.trustpilot_link != blank %}
                  </a>
                {% endif %}
              </div>
            {% endif %}
            {% if section.settings.trustpilot_logo %}
              <div class="ns-trustpilot-logo">
                {% if section.settings.trustpilot_link != blank %}
                  <a target="_blank" href="{{ section.settings.trustpilot_link }}">
                {% endif %}
                {{ section.settings.trustpilot_logo | image_url: width: section.settings.trustpilot_logo.width | image_tag: loading: 'lazy' }}
                {% if section.settings.trustpilot_link != blank %}
                  </a>
                {% endif %}
              </div>
            {% endif %}
          </div>

          <div class="ns-trustpilot-right">
            <div class="ns-trustpilot-reviews-slider" desktop_slide="{{ section.settings.desktop_slide }}" mobile_slide="{{ section.settings.mobile_slide }}" autoplay="{% if section.settings.autoplay > 0 %}{{ section.settings.autoplay | times: 1000 }}{% else %}false{% endif %}" arrows="{{ section.settings.show_arrows }}" dots="{{ section.settings.show_dots }}" progress="{{ section.settings.show_progress }}" readmore="{{ section.settings.show_read_more }}">
              {% for review in shop.metaobjects.trustpilot_reviews.values limit: review_limit %}
                <div class="ns-trustpilot-reviews-slide">
                  {% if section.settings.trustpilot_stars %}
                    <div class="ns-trustpilot-stars">
                      {% if section.settings.trustpilot_link != blank %}
                        <a target="_blank" href="{{ section.settings.trustpilot_link }}">
                      {% endif %}
                      {{ section.settings.trustpilot_stars | image_url: width: section.settings.trustpilot_stars.width | image_tag: loading: 'lazy' }}

                      {% if section.settings.trustpilot_link != blank %}
                        </a>
                      {% endif %}
                    </div>
                  {% endif %}

                  <div class="content">
                    {% if review.title != blank %}
                      <div class="name">{{ review.title }}</div>
                    {% endif %}
                    {% assign review_text = review.review | metafield_tag %}
                    {% assign wordlimit = review_text | size %}
                    {% if wordlimit < 70 or section.settings.show_read_more == false %}
                      <div class="descriptions">{{ review_text }}</div>
                    {% else %}
                      <div class="description_list">
                        <div class="descriptions_short">{{ review.review | metafield_text | truncate: 70 }}<span class="read_more_div">...<strong>Læs mere</strong></span></div>
                        <div class="descriptions_full full_content_hide">
                          {% if section.settings.trustpilot_stars %}
                            <div class="ns-trustpilot-stars">
                              {% if section.settings.trustpilot_link != blank %}
                                <a target="_blank" href="{{ section.settings.trustpilot_link }}">
                              {% endif %}
                              {{ section.settings.trustpilot_stars | image_url: width: section.settings.trustpilot_stars.width | image_tag: loading: 'eager' }}
        
                              {% if section.settings.trustpilot_link != blank %}
                                </a>
                              {% endif %}
                            </div>
                          {% endif %}
                          {% if review.title != blank %}
                            <div class="name">{{ review.title }}</div>
                          {% endif %}
                          {{ review_text }}
                          {% if review.name != blank %}
                            <div class="author">{{ review.name }}</div>
                          {% endif %}
                        </div>
                          
                      </div>
                    {% endif %}
                    {% if review.name != blank %}
                      <div class="author">{{ review.name }}</div>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>
            <div class="progress-bar-container" style="{% if section.settings.show_progress == false %}display:none;{% endif %}">
              <div class="progress-bar"></div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<div id="myModal" class="modal">
  <div class="modal-content">
    <span class="close">&times;</span>
    <p class="content">Some text in the Modal..</p>
  </div>
</div>

  <script>
  document.addEventListener("DOMContentLoaded", function () {
    var modal = document.getElementById("myModal");
    var modalContent = document.querySelector(".modal-content p");
    var span = document.getElementsByClassName("close")[0];
    span.onclick = function() {
      modal.style.display = "none";
    }
    window.onclick = function(event) {
      if (event.target == modal) {
        modal.style.display = "none";
      }
    }
    const read_more_div = document.querySelectorAll(".read_more_div");
    read_more_div.forEach(button => {
        button.addEventListener('click', (event) => {
          const parent = event.target.closest('.description_list');
          console.log('parent',parent);
          const parentInnertext = parent.querySelector(".full_content_hide")
          
          modalContent.innerHTML = parentInnertext.innerHTML
          modal.style.display = "block";
            console.log('Button clicked:', event.target);
        });
    });
    
  const sectionId = "ns-trustpilot-reviews-{{ section.id }}";
  const section = document.getElementById(sectionId);
  if (!section) return;

  const sliderContainer = section.querySelector(".ns-trustpilot-reviews-slider");
  let flkty = null;

  const mobileSlide = parseFloat(sliderContainer.getAttribute("mobile_slide") || "2");
  const desktopSlide = parseFloat(sliderContainer.getAttribute("desktop_slide") || "3");

    

  function getSlidesToShow() {
    if (window.innerWidth > 767) return desktopSlide;
    return mobileSlide;
  }

  function initializeFlickity() {
    if (!sliderContainer) return;

    let progressBar = section.querySelector(".progress-bar");
    if (!progressBar) return;

    if (flkty) {
      flkty.destroy(); // Destroy previous instance before reinitializing
      flkty = null;
    }

    let slidesToShow = getSlidesToShow();
    let groupCells = Math.floor(slidesToShow);
    let totalSlides = sliderContainer.children.length;

    const autoplayAttr = sliderContainer.getAttribute("autoplay");
      const autoplay = autoplayAttr === "false" ? false : parseInt(autoplayAttr, 10);
      
      flkty = new Flickity(sliderContainer, {
        cellAlign: "left",
        contain: true,
        wrapAround: autoplay !== false, // true only if autoplay is a number
        prevNextButtons: JSON.parse(sliderContainer.getAttribute("arrows") || "false"),
        pageDots: JSON.parse(sliderContainer.getAttribute("dots") || "false"),
        autoPlay: autoplay,
        freeScroll: false,
        draggable: true,
        groupCells: groupCells,
      });

    let prevButton = sliderContainer.querySelector(".flickity-prev-next-button.previous");
    let nextButton = sliderContainer.querySelector(".flickity-prev-next-button.next");


    function updateProgress() {
      let scrollPosition = Math.abs(flkty.x); // Get scroll position in pixels (positive value)
      let maxScroll = flkty.slideableWidth - flkty.size.width; // Maximum scrollable distance

      let progress = scrollPosition / maxScroll;
      progressBar.style.width = `${Math.min(progress * 100, 100)}%`;
    }

    function updateArrows() {
      if (!prevButton || !nextButton) return;
            console.log("dsfgdas")

      let scrollPosition = Math.abs(flkty.x);
      let maxScroll = flkty.slideableWidth - flkty.size.width;

      console.log("scrollPosition",scrollPosition)
      prevButton.disabled = scrollPosition <= 1;
      nextButton.disabled = scrollPosition >= maxScroll - 5; // Buffer to avoid rounding errors
    }

    flkty.on("change", () => {
      updateProgress();
      updateArrows();
    });
    flkty.on("scroll", () => {
      updateProgress();
      updateArrows();
    });

    updateProgress();
    updateArrows();
  }
    
  let lastWidth = window.innerWidth;
  window.addEventListener("resize", function () {
    if (window.innerWidth !== lastWidth) {
      console.log("Width changed!");
      lastWidth = window.innerWidth;
      initializeFlickity();
    }
  });

  // window.addEventListener("resize", () => {
  //   setTimeout(initializeFlickity, 300); // Debounce to prevent frequent flickity re-initialization
  // });

  initializeFlickity(); // Run on page load
});

</script>
{% endif %}

