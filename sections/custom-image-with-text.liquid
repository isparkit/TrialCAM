{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="custom-image-with-text section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="custom-inner {{ section.settings.layout }}">
      
      <div class="image-col double-image">
        {% if section.settings.image_1 %}
          <div class="image-box image-one">
            <img src="{{ section.settings.image_1 | img_url: '600x' }}" alt="Image One">
          </div>
        {% endif %}
        {% if section.settings.image_2 %}
          <div class="image-box image-two">
            <img src="{{ section.settings.image_2 | img_url: '600x' }}" alt="Image Two">
          </div>
        {% endif %}
      </div>
      
      <div class="content-col">
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subtext != blank %}
          <div>{{ section.settings.subtext }}</div>
        {% endif %}
        {% if section.settings.button_label != blank and section.settings.button_link != blank %}
          <a href="{{ section.settings.button_link }}" class="custom-green-btn">
            {{ section.settings.button_label }}  
            <svg xmlns="http://www.w3.org/2000/svg" width="41" height="19" viewBox="0 0 41 19" fill="none">
            <rect x="40.25" y="0.920166" width="16.5" height="39.5" rx="8.25" transform="rotate(90 40.25 0.920166)" stroke="white" stroke-width="1.5"/>
            <path d="M36.25 9.17017C36.25 12.0697 33.8995 14.4202 31 14.4202C28.1005 14.4202 25.75 12.0697 25.75 9.17017C25.75 6.27067 28.1005 3.92017 31 3.92017C33.8995 3.92017 36.25 6.27067 36.25 9.17017Z" stroke="white" stroke-width="1.5"/>
            <ellipse cx="31" cy="9.17017" rx="3" ry="3" transform="rotate(90 31 9.17017)" fill="white"/>
            <rect x="15.25" y="5.92017" width="6.5" height="10.5" rx="3.25" transform="rotate(90 15.25 5.92017)" stroke="white" stroke-width="1.5"/>
            <rect x="12" y="8.17017" width="2" height="4" rx="1" transform="rotate(90 12 8.17017)" fill="white"/>
            </svg>
          </a>
        {% endif %}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Image With Text",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "background-1"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "First Image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Second Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This is heading"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Custom Image With Text",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<style>
.custom-inner {
  display: flex;
  align-items: center;
  gap: 40px;
  width: 100%;
}
.custom-inner.left {
  flex-direction: row;
}
.custom-inner.right {
  flex-direction: row-reverse;
  text-align: left;
}
.custom-image-with-text .custom-inner .image-col.double-image {
    display: flex;
    align-items: center;
    gap: 20px;
    width: 50%;
}
.custom-image-with-text .custom-inner.right .image-col.double-image {
    flex-direction: row-reverse;
}
.custom-image-with-text .custom-inner.right .image-col.double-image .image-box img {
  width: 100%;
  display: block;
}
.custom-image-with-text .custom-inner .image-col.double-image .image-box.image-one {
    border: 2px dotted #57A014;
    padding: 10px;
    border-radius: 500px;
}
.custom-image-with-text .custom-inner .image-col.double-image .image-box.image-one img {
    border-radius: 500px;
    height: auto;
    width: 100%;
    object-fit: cover;
}
.custom-image-with-text .custom-inner .image-col.double-image .image-box.image-two img {
    border-radius: 150px;
    width: 100%;
    height: auto;
    object-fit: cover;
    max-width: 280px;
}
.custom-image-with-text .custom-inner .image-col.double-image .image-box.image-two {
    border: 2px dotted #57A014;
    padding: 10px;
    border-radius: 150px;
}
.custom-image-with-text .custom-inner .content-col {
    width: 50%;
}
.custom-image-with-text .custom-inner .content-col h2 {
  font-size: 32px;
  margin-bottom: 15px;
}
.custom-image-with-text .custom-inner .content-col p {
  font-size: 18px;
  margin-bottom: 20px;
}
.custom-image-with-text .custom-inner .content-col .custom-green-btn {
    display: inline-block;
    padding: 16px 20px;
    background: #57A014;
    color: #fff;
    text-decoration: none;
    border-radius: 6px;
}
    @media(max-width: 768px) {
    .custom-inner {
    flex-direction: column !important; /* force column on mobile */
    text-align: center;
    }
    .custom-image-with-text .custom-inner .image-col.double-image {
        width: 100%;
        flex-direction: column;
    }
    .custom-image-with-text .custom-inner.right .image-col.double-image{
        flex-direction: column;
    }
    .custom-image-with-text .custom-inner .content-col {
    width: 100%;
    }
    }
</style>
