    }

    flkty.on("change", () => {
      updateArrows();
    });
    flkty.on("scroll", () => {
      updateArrows();
    });

    updateArrows();
  }
    
  let lastWidth = window.innerWidth;
  window.addEventListener("resize", function () {
    if (window.innerWidth !== lastWidth) {
      console.log("Width changed!");
