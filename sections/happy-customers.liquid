{% schema %}
{
  "name": "Happy Customers",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "min": 5,
      "max": 20,
      "step": 1,
      "id": "review_limit",
      "label": "Review limit",
      "default":10
    },
    {
      "type": "text",
      "id": "title",
      "default": "1000+ Happy Customers",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "default": "<p>4.5 Stars | Based on 100 reviews</p>",
      "label": "Description"
    },
    {
      "type": "image_picker",
      "id": "trustpilot_logo",
      "label": "Trustpilot logo"
    },
    {
      "type": "url",
      "id": "trustpilot_url",
      "label": "Trustpilot URL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "label": "Heading alignment"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Number of columns"
    },
    {
      "type": "range",
      "id": "container_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Container border radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "media_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Media border radius",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_media_shadow",
      "default": true,
      "label": "Show media shadow"
    },
    {
      "type": "header",
      "content": "Carousel Settings"
    },
    
    {
      "type": "range",
      "id": "autoplay_slider",
      "min": 0,
      "max": 9,
      "step": 1,
      "unit": "s",
      "label": "Autoplay",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "default": true,
      "label": "Pause auto-rotation on hover"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "default": true,
