    },
    {
      "type": "header",
      "content": "Image Settings"
    },

    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Image border radius",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "image_shadow",
      "default": true,
      "label": "Add shadow to images"
    },
    {
      "type": "header",
      "content": "Accordion Settings"
    },
    {
      "type": "color",
      "id": "accordion_background",
      "label": "Accordion background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accordion_hover_background",
      "label": "Accordion hover background",
      "default": "#F8F8F8"
    },
    {
      "type": "color",
      "id": "accordion_border_color",
      "label": "Accordion border color",
      "default": "#EEEEEE"
    },
    {
      "type": "range",
      "id": "accordion_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Accordion border radius",
      "default": 8
    },
    {
      "type": "color",
      "id": "accordion_title_color",
      "label": "Accordion title color"
    },
    {
