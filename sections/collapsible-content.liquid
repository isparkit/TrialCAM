      "id": "footer_text_color",
      "label": "Footer text color"
    },
    {
      "type": "color",
      "id": "footer_link_color",
      "label": "Footer link color"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
