<style>
  .custom-accrodian .collapsible-section__heading {
    text-align: start !important;
    font-weight: 700 !important;
    line-height: 1em;
    letter-spacing: 0px;
    color: #000000;
  }
  .custom-accrodian .collapsible-section__heading {
    text-align: start !important;
  }
  .custom-accrodian .collapsible-section__images {
    border: 1px dashed #57a014;
    padding: 15px;
  }
  .custom-accrodian .accordion__item {
    border: 1px dashed #57a014 !important;
  }
  .custom-accrodian details[open] .accordion__panel {
    border-top: 1px dashed #57a014 !important;
  }
  .custom-accrodian .accordion__button h6 {
    margin: 0px !important;
    font-weight: 700;
    letter-spacing: 0px;
    color: #000000;
    line-height: 26px;
  }
  .custom-accrodian .accordion__panel p {
    font-size: 16px;
    font-weight: 400;
    font-family: 'Roboto';
    color: #000000;
    line-height: 24px;
    letter-spacing: 0px;
  }
  .custom-accrodian .collapsible-section__container {
    gap: 40px !important;
  }
</style>
