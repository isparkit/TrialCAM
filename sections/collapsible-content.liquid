{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-accordion.js' | asset_url }}" defer></script>
{{ 'collapsible-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 1 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 1 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }

  .collapsible-section {
    {% if section.settings.background != blank %}
      background-color: {{ section.settings.background }};
    {% endif %}
  }

  .collapsible-section__heading {
    margin-top: 0;
    margin-bottom: {{ section.settings.heading_spacing }}px;
    font-size: {{ section.settings.heading_size }}px;
    text-align: {{ section.settings.heading_alignment }};
    font-weight: {{ section.settings.heading_weight }};
    {% if section.settings.heading_color != blank %}
      color: {{ section.settings.heading_color }};
    {% endif %}
  }

  .collapsible-section__container {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    align-items: center;
  }

  {% if section.settings.show_images == false %}
    .collapsible-section__content {
      width: 100%;
      margin: 0 auto;
      max-width: {{ section.settings.content_width }}px;
    }
  {% else %}
    .collapsible-section__images {
      flex: 1;
      min-width: 400px;
      position: relative;
      text-align: center;
    }

    .collapsible-section__content {
      flex: 1.5;
      min-width: 300px;
    }
  {% endif %}
  .collapsible-section__images:has(.collapsible-section__image:nth-child(2)) .collapsible-section__image:nth-child(1){
    width: 85%;
  }
  .collapsible-section__images:has(.collapsible-section__image:nth-child(2)){
    padding-block: 30px;
  }
  .collapsible-section__image {
    width: 100%;
    aspect-ratio: 1;
    position: unset;
    {% if section.settings.image_shadow %}
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    {% endif %}
  }

  .collapsible-section__image:nth-child(2) {
    position: absolute;
    right: 0;
    top: 0;
    max-width: 90px;
  }

  .collapsible-section__image:nth-child(3) {
    position: absolute;
    left: 0;
    bottom: 0;
    max-width: 90px;
  }


  .collapsible-section__accordion {
    margin-bottom: 30px;
  }

  .accordion__button {
    background: {{ section.settings.accordion_background | default: '#FFFFFF' }};
    cursor: pointer;
    border: 1px solid {{ section.settings.accordion_border_color | default: '#EEEEEE' }};
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem;
    width: 100%;
    text-align: left;
    border-radius: {{ section.settings.accordion_radius }}px;
    /* margin-bottom: 10px; */
    transition: background 0.3s;
  }

  .accordion__button:hover {
    background: {{ section.settings.accordion_hover_background | default: '#F8F8F8' }};
  }

  .accordion__button h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    {% if section.settings.accordion_title_color != blank %}
      color: {{ section.settings.accordion_title_color }};
    {% endif %}
  }

  .accordion__button .icon {
    width: 1.5rem;
    height: 1.5rem;
    transition: transform 0.3s;
    display: flex;
  }

  .accordion__button[aria-expanded="true"] .icon {
    transform: rotate(180deg);
  }

  .accordion__panel {
    overflow: hidden;
    height: 0;
    opacity: 0;
    transition: opacity 0.3s, height 0.3s;
    padding: 0 1.5rem;
    margin-bottom: 10px;
  }

  .accordion__panel[aria-hidden="false"] {
    height: auto;
    opacity: 1;
    padding: 1.5rem;
    {% if section.settings.accordion_content_color != blank %}
      color: {{ section.settings.accordion_content_color }};
    {% endif %}
  }

  .collapsible-section__footer {
    text-align: center;
    margin-top: 20px;
  }

  .collapsible-section__footer-text {
    {% if section.settings.footer_text_color != blank %}
      color: {{ section.settings.footer_text_color }};
    {% endif %}
    margin-bottom: 10px;
  }

  .collapsible-section__footer-link {
    display: inline-block;
    {% if section.settings.footer_link_color != blank %}
      color: {{ section.settings.footer_link_color }};
    {% endif %}
    text-decoration: underline;
    color: inherit;
  }

  @media screen and (max-width: 767px) {
    .collapsible-section__images {
      width: 100%;
      min-width: 350px;
    }
    .collapsible-section__heading {
      font-size: calc({{ section.settings.heading_size }}px * 0.8);
    }

    .collapsible-section__images {
      flex: 1 0 100%;
      order: 1;
      height: {{ section.settings.images_height_mobile }}px;
    }

    .collapsible-section__content {
      flex: 1 0 100%;
      order: 2;
    }

    .collapsible-section__image {
      max-height: {{ section.settings.image_height_mobile }}px;
    }


  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    class="custom-accrodian collapsible-section section-{{ section.id }}-padding"
    style="{% if section.settings.background != blank %}background-color: {{ section.settings.background }};{% endif %}"
  >
    <div class="page-width">
      {% unless section.settings.show_images and section.settings.heading_position == 'in_content' %}
        {% comment %}
          <h2
            class=""
            style="
              margin-bottom: {{ section.settings.heading_spacing }}px;
              font-size: {{ section.settings.heading_size }}px;
              text-align: {{ section.settings.heading_alignment }};
              font-weight: {{ section.settings.heading_weight }};
              {% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %}
            "
          >
            {{ section.settings.heading }}
          </h2>
        {% endcomment %}
      {% endunless %}

      <div class="collapsible-section__container">
        {% if section.settings.show_images %}
          <div class="collapsible-section__images" style="height: {{ section.settings.images_height }}px;">
            {% for block in section.blocks %}
              {% if block.type == 'image' and block.settings.image != blank %}
                {% assign image_offset = section.settings.image_offset %}
                {% assign top_position = forloop.index0 | times: image_offset %}
                {% assign left_position = forloop.index0 | times: image_offset %}
                {% assign z_index = 3 | minus: forloop.index0 %}

                <img
                  src="{{ block.settings.image | image_url: width: 500 }}"
                  loading="lazy"
                  width="500"
                  height="500"
                  alt="{{ block.settings.image.alt | default: section.settings.heading }}"
                  class="collapsible-section__image"
                  style="
                    {% if section.settings.image_shadow %}
                      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
                    {% endif %}
                  "
                >
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        <div
          class="collapsible-section__content"
          {% if section.settings.show_images == false %}
            style="width: 100%; margin: 0 auto; max-width: {{ section.settings.content_width }}px;"
          {% endif %}
        >
          {% if section.settings.show_images and section.settings.heading_position == 'in_content' %}
            {% comment %}
              <h2 class="collapsible-section__heading" style="
                margin-bottom: {{ section.settings.heading_spacing }}px;
                font-size: {{ section.settings.heading_size }}px;
                text-align: {{ section.settings.heading_alignment }};
                font-weight: {{ section.settings.heading_weight }};
                {% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %}
              ">{{ section.settings.heading }}</h2>
            {% endcomment %}
          {% endif %}

          <collapsible-accordion class="collapsible-section__accordion">
            <h2
              class="collapsible-section__heading"
              style="
                margin-bottom: {{ section.settings.heading_spacing }}px;
                font-size: {{ section.settings.heading_size }}px;
                text-align: {{ section.settings.heading_alignment }};
                font-weight: {{ section.settings.heading_weight }};
                {% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %}
              "
            >
              {{ section.settings.heading }}
            </h2>
            {% for block in section.blocks %}
              {% if block.type == 'collapsible_row' %}
                <details
                  id="Details-{{ block.id }}-{{ section.id }}"
                  class="accordion__item"
                  {{ block.shopify_attributes }}
                >
                  <summary
                    class="accordion__button"
                    style="
                      background: {{ section.settings.accordion_background | default: '#FFFFFF' }};
                      border: 1px solid {{ section.settings.accordion_border_color | default: '#EEEEEE' }};
                      border-radius: {{ section.settings.accordion_radius }}px;
                    "
                  >
                    <h6 style="{% if section.settings.accordion_title_color != blank %}color: {{ section.settings.accordion_title_color }};{% endif %}">
                      {{ block.settings.heading | default: block.settings.page.title }}
                    </h6>
                    <span class="icon">
                      {% comment %}
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                          aria-hidden="true"
                          focusable="false"
                        >
                          <path d="M19 8.5L12 15.5L5 8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      {% endcomment %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" viewBox="0 0 35 35" fill="none">
                        <rect x="0.85791" y="0.479004" width="34.1421" height="34.1421" rx="17.0711" fill="#57A014"/>
                        <path d="M23.76 16.6733C24.2443 16.6733 24.6368 17.0659 24.6368 17.5501C24.6367 18.0343 24.2443 18.4269 23.76 18.4269L18.8058 18.4265V23.3812C18.8057 23.8654 18.4132 24.258 17.929 24.258C17.4447 24.258 17.0522 23.8654 17.0521 23.3812V18.4265L12.0979 18.4269C11.6136 18.4269 11.2212 18.0343 11.2211 17.5501C11.2211 17.0659 11.6136 16.6733 12.0979 16.6733L17.0521 16.6728L17.0521 11.719C17.0521 11.2347 17.4447 10.8422 17.929 10.8422C18.4133 10.8422 18.8058 11.2347 18.8058 11.719L18.8058 16.6728L23.76 16.6733Z" fill="black"/>
                      </svg>
                    </span>
                  </summary>
                  <div
                    class="accordion__panel rte"
                    style="{% if section.settings.accordion_content_color != blank %}color: {{ section.settings.accordion_content_color }};{% endif %}"
                  >
                    {% if block.settings.row_content != blank %}
                      {{ block.settings.row_content }}
                    {% endif %}
                    {% if block.settings.page.content != blank %}
                      {{ block.settings.page.content }}
                    {% endif %}
                  </div>
                </details>
              {% endif %}
            {% endfor %}
          </collapsible-accordion>

          {% if section.settings.footer_text != blank
            and section.settings.footer_link_text != blank
            and section.settings.footer_link_url != blank
          %}
            <div class="collapsible-section__footer">
              {% if section.settings.footer_text != blank %}
                <p
                  class="collapsible-section__footer-text"
                  style="{% if section.settings.footer_text_color != blank %}color: {{ section.settings.footer_text_color }};{% endif %}"
                >
                  {{ section.settings.footer_text }}
                </p>
              {% endif %}

              {% if section.settings.footer_link_text != blank and section.settings.footer_link_url != blank %}
                <a
                  href="{{ section.settings.footer_link_url }}"
                  class="collapsible-section__footer-link"
                  style="{% if section.settings.footer_link_color != blank %}color: {{ section.settings.footer_link_color }};{% endif %}"
                >
                  {{ section.settings.footer_link_text }}
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Mobile styles */
  @media screen and (max-width: 749px) {
    .collapsible-section__heading {
      font-size: calc({{ section.settings.heading_size }}px * 0.8) !important;
    }

    .collapsible-section__images {
      flex: 1 0 100%;
      order: 1;
      height: {{ section.settings.images_height_mobile }}px !important;
    }

    .collapsible-section__content {
      flex: 1 0 100%;
      order: 2;
    }

    .collapsible-section__image {
      max-height: {{ section.settings.image_height_mobile }}px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Collapsible content",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Ofte Stillede Spørgsmål",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Heading alignment"
    },
    {
      "type": "select",
      "id": "heading_position",
      "options": [
        {
          "value": "above",
          "label": "Above content"
        },
        {
          "value": "in_content",
          "label": "Inside content column"
        }
      ],
      "default": "above",
      "label": "Heading position"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Heading bottom spacing",
      "default": 30
    },
    {
      "type": "select",
      "id": "heading_weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600",
      "label": "Heading weight"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
