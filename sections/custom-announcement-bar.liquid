{{ 'custom-announcement-bar.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-announcement-bar.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .custom-announcement-section {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    /* padding: 0 0.5rem; */
  }
   
  .announcement-block__icon svg {
    fill: {{ section.settings.icon_color }};
    color: {{ section.settings.icon_color }};
  }

  .announcement-block__icon svg path {
    fill: {{ section.settings.icon_color }};
    color: {{ section.settings.icon_color }};
  }

  .slide-control {
    /* background: {{ section.settings.mobile_icon_background }}; */
  }
  
  .slide-control:hover {
    /* background: {{ section.settings.mobile_icon_background | color_modify: 'alpha', 0.8 }}; */
  }

  .slide-control svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: {{ section.settings.text_color }};
    stroke-width: 2px;
  }
  
  .slide-control svg path {
    fill: none;
    stroke: {{ section.settings.text_color }};
    stroke-width: 2px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
{%- endstyle -%}

<div class="custom-announcement-section page-width">
  <custom-announcement-bar 
    class="custom-announcement 
    custom-announcement--padding-top-{{ section.settings.padding_top }} 
    custom-announcement--padding-bottom-{{ section.settings.padding_bottom }}" 
    data-auto-rotate="{{ section.settings.auto_rotate }}"
    data-rotate-speed="{{ section.settings.change_slides_speed }}">

    <!-- Desktop: Display all blocks in a row -->
    <div class="announcement-blocks">
      {% for block in section.blocks %}
        {% if forloop.index <= 4 %}
          <div class="announcement-block announcement-block--padding-horizontal-{{ section.settings.padding_horizontal }}" {{ block.shopify_attributes }}>
            {% if block.settings.icon_svg != blank %}
              <div class="announcement-block__icon"> 
                {{ block.settings.icon_svg }}
              </div>
            {% elsif block.settings.icon != blank %}
              <div class="announcement-block__icon">
                {% render 'icon', icon: block.settings.icon %}
              </div>
            {% endif %}
            <div class="announcement-block__text">
              {{ block.settings.text }}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    
    <!-- Mobile: Display as slideshow -->
    <div class="slideshow-container" data-autorotate="{{ section.settings.auto_rotate }}" data-interval="{{ section.settings.rotation_interval | times: 1000 }}">
      {% for block in section.blocks %}
        <div class="announcement-slide {% if forloop.first %}active{% endif %}" id="announcement-slide-{{ forloop.index0 }}" data-index="{{ forloop.index0 }}" data-block-id="{{ block.id }}">
          {% render 'announcement-block', block: block, index: forloop.index %}
        </div>
      {% endfor %}

      {% if section.blocks.size > 1 %}
        {% if section.settings.show_navigation_arrows %}
          <button type="button" class="slide-control slide-control--prev" aria-label="Previous announcement">
            <span class="svg-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16">
                <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </button>
          
          <button type="button" class="slide-control slide-control--next" aria-label="Next announcement">
            <span class="svg-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16">
                <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </button>
        {% endif %}
        
        <!-- Indicators -->
        <div class="slide-indicators" style="display: none;">
          {% for block in section.blocks %}
            <button 
              type="button" 
              class="slide-indicator{% if forloop.first %} active{% endif %}" 
              aria-label="Slide {{ forloop.index }}"
              data-index="{{ forloop.index0 }}"
            ></button>
          {% endfor %}
        </div>
      {% endif %}
    </div>
    
  </custom-announcement-bar>
</div>

{% schema %}
{
  "name": "Custom Announcement Bar",
  "tag": "section",
  "class": "section custom-announcement-section",
  "max_blocks": 4,
  "settings": [
