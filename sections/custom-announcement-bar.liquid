  ]
}
{% endschema %}

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Slideshow functionality
  const slideshowContainer = document.querySelector('.slideshow-container');
  if (!slideshowContainer) return;
  
  const slides = slideshowContainer.querySelectorAll('.announcement-slide');
  const prevButton = slideshowContainer.querySelector('.slide-control--prev');
  const nextButton = slideshowContainer.querySelector('.slide-control--next');
  const indicators = slideshowContainer.querySelectorAll('.slide-indicator');
  
  if (slides.length <= 1) return;
  
  let currentIndex = 0;
  let intervalId = null;
  
  // Function to show a specific slide
  function showSlide(index) {
    if (index < 0) index = slides.length - 1;
    if (index >= slides.length) index = 0;
    
    // Hide all slides
    slides.forEach(slide => slide.classList.remove('active'));
    
    // Show the selected slide
    slides[index].classList.add('active');
    
    // Update indicators
    indicators.forEach((indicator, i) => {
      indicator.classList.toggle('active', i === index);
    });
    
    currentIndex = index;
  }
  
  // Set up autorotation if enabled
  function setupAutoRotation() {
    if (slideshowContainer.dataset.autorotate === 'true') {
      const interval = parseInt(slideshowContainer.dataset.interval) || 5000;
      
      // Clear any existing interval
      if (intervalId) clearInterval(intervalId);
      
      // Set up new interval
      intervalId = setInterval(() => {
        showSlide(currentIndex + 1);
      }, interval);
    }
  }
  
  // Initialize autorotation
  setupAutoRotation();
  
  // Previous button click
  if (prevButton) {
    prevButton.addEventListener('click', () => {
      showSlide(currentIndex - 1);
      // Reset autorotation
      if (intervalId) clearInterval(intervalId);
      setupAutoRotation();
    });
  }
  
  // Next button click
  if (nextButton) {
    nextButton.addEventListener('click', () => {
      showSlide(currentIndex + 1);
      // Reset autorotation
      if (intervalId) clearInterval(intervalId);
      setupAutoRotation();
    });
  }
  
  // Indicator clicks
  indicators.forEach((indicator, index) => {
    indicator.addEventListener('click', () => {
      showSlide(index);
      // Reset autorotation
      if (intervalId) clearInterval(intervalId);
      setupAutoRotation();
    });
  });
});
</script> 