<div class="comparison-table-section full--content--section" id="sec-{{ section.id }}">
  <div class="page-width feature-row-wrapper">
<div class="table-container container--large">
  <div class="row">
    <div class="columnone">
      {% if section.settings.title != blank %}
      <h2 class="brand_name bold">{{ section.settings.title }}</h2>
      {% endif %}
      <div class="product__title heading-size--page-title">
      {% if section.settings.subtitle != blank %}
      {{ section.settings.subtitle }}
      {% endif %}
      </div>
      <div class="display_desktop_only">
        {% if section.settings.button_text != blank %}
        <a class="btn" href="{{section.settings.button_link}}">{{section.settings.button_text}}</a>
        {% endif %}
      </div>
    </div>
    <div class="columntwo">
      <div class="kh_main">
        <div class="com_row">
          <div class="com_info">
            {% if section.settings.tb_heading_1 != blank %}
            <h5 class="com_heading">{{ section.settings.tb_heading_1 }}</h5>
            {% endif %}
          </div>
          <div class="com_info com_info2">
            {% if section.settings.tb_heading_2 != blank %}
              <div class="logo_com logo_ex">
                {{ section.settings.tb_heading_2 | image_url: width: section.settings.tb_heading_2.width | image_tag: loading: 'lazy' }}
              </div>
            {% endif %}
            {% if section.settings.tb_heading_2a != blank %}
              <h5 class="com_heading">{{ section.settings.tb_heading_2a }}</h5>
            {% endif %}
          </div>
          <div class="com_info com_info2">
          {% if section.settings.tb_heading_3 != blank %}
             <div class="logo_com logo_ex">
              {{ section.settings.tb_heading_3 | image_url: width: section.settings.tb_heading_3.width | image_tag: loading: 'lazy' }}
            </div>
          {% endif %}
            {% if section.settings.tb_heading_3a != blank %}
            <h5 class="com_heading">{{ section.settings.tb_heading_3a }}</h5>
            {% endif %}
          </div>
        </div> 


        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% if block.settings.title != blank %}
              <div class="child_row">
              <div class="child_info">
              <p>{{ block.settings.title }}</p>
              </div>
              <div class="child_info child_info2">
                {% assign feature_yes_no = block.settings.prd_feature_yes_no | downcase %}
                {% if feature_yes_no == "yes" %}
                  {{ section.settings.check_regular | image_url: width: section.settings.check_regular.width | image_tag: loading: 'lazy' , class: 'checkIcon' }}
                {% elsif feature_yes_no == "no" %}
                  {{ section.settings.cross_regular | image_url: width: section.settings.cross_regular.width | image_tag: loading: 'lazy' , class: 'crossIcon' }}
                {% else %}
                  <span class="feat_text">{{ block.settings.prd_feature_yes_no }}</span>
                {% endif %}
              </div>
              <div class="child_info child_info2">
                {% assign bbfeature_yes_no = block.settings.other_brand_feature_yes_no | downcase %}
              {% if bbfeature_yes_no == "no" %}
                  {{ section.settings.cross_regular | image_url: width: section.settings.cross_regular.width | image_tag: loading: 'lazy' , class: 'crossIcon' }}
              {% elsif bbfeature_yes_no == "yes" %}
                  {{ section.settings.check_regular | image_url: width: section.settings.check_regular.width | image_tag: loading: 'lazy' , class: 'checkIcon' }}
              {% else %}
                  <span class="feat_text"> {{ block.settings.other_brand_feature_yes_no }}</span>
                {% endif %}
              </div>
              </div>
            {% endif %}
          {% endfor %}
        {% endif %}      
      </div>
    </div>
  </div>
  <div class="row custom-mobile-row">
      <div class="display_mobile_only">
        {% if section.settings.button_text != blank %}
        <a class="btn" href="{{section.settings.button_link}}">{{section.settings.button_text}}</a>
        {% endif %}
      </div>
  </div>
</div>
</div>
</div>
  {% endif %}

{% schema %}
  {
    "name": "Comparison Table",
    "class": "index-section",
    "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Image with text"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Description",
    },
    {
      "type": "header",
       "content":"Table Headings"
    },
    {
      "type": "text",
      "id": "tb_heading_1",
      "label": "Features Title"
    },
    {
      "type": "image_picker",
      "id": "tb_heading_2",
      "label": "Product Image"
    },
      {
      "type": "text",
      "id": "tb_heading_2a",
      "label": "Product Title"
    },
    {
      "type": "image_picker",
      "id": "tb_heading_3",
      "label": "Other Brand Image"
    },
      {
      "type": "text",
      "id": "tb_heading_3a",
      "label": "Other Brand Title"
    },
    {
      "type": "header",
       "content":"Check Mark Icons"
    },
    {
      "type": "image_picker",
      "id": "check_regular",
      "label": "Check Regular"
    },
    {
      "type": "image_picker",
      "id": "cross_regular",
      "label": "Cross Regular"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 180,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 180,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
    ],
    "blocks": [
    {
      "type": "tablerow",
      "name": "Table Row",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Feature"
        },
        {
          "type": "text",
          "id": "prd_feature_yes_no",
          "label": "Product have this feature"
        },
        {
          "type": "text",
          "id": "other_brand_feature_yes_no",
          "label": "Other Brand have feature in product"
        }
      ]
    }
    ],
    "presets": [{"name": "Comparison Table"}]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

