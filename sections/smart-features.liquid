{{ 'smart-features.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 1 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 1 | round: 0 }}px;
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
  
  .smart-features {
    {% if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
    {% if section.settings.text_color != blank %}
      color: {{ section.settings.text_color }};
    {% endif %}
    /* padding: 0 20px; */
  } 
  
  .smart-features__header {
    position: relative;
    padding-bottom: 2rem;
    margin-bottom: 3rem;
    text-align: {{ section.settings.heading_alignment }};
  }
  
  .smart-features__heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    color: {{ section.settings.heading_color | default: section.settings.text_color }};
    margin: 0;
    {% if section.settings.heading_alignment == 'left' %}
      display: flex;
      align-items: center;
    {% endif %}
  }
  
  .smart-features__heading-line {
    {% if section.settings.heading_alignment == 'left' %}
      display: inline-block;
        width: 7px;
      height: {{ section.settings.heading_size | times: 2.2 }}px;
      background-color: {{ section.settings.accent_color | default: '#ff5a5f' }};
      margin-right: 1.5rem;
    {% else %}
      display: block;
      width: 7px;
      height: {{ section.settings.heading_size | times: 2.2 }}px;
      background-color: {{ section.settings.accent_color | default: '#ff5a5f' }};
      margin: 0 auto 1.5rem;
    {% endif %}
  }
  
  .smart-features__subheading {
    margin-top: 1rem;
    font-size: {{ section.settings.subheading_size }}px;
    font-weight: 400;
    color: {{ section.settings.subheading_color | default: section.settings.text_color }};
  }
  
  .smart-features__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    grid-gap: 2rem;
  }
  
  @media screen and (max-width: 767px) {
    .smart-features__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      grid-gap: 1.5rem;
    }
  }
  
  .smart-features__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  
  .smart-features__icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    margin-bottom: 1.5rem;
    {% if section.settings.icon_background %}
      background-color: {{ section.settings.icon_background_color }};
      border-radius: {{ section.settings.icon_border_radius }}px;
    {% endif %}
  }
  
  .smart-features__icon svg {
    width: calc({{ section.settings.icon_size }}px * 0.9);
    height: calc({{ section.settings.icon_size }}px * 0.9);
    fill: {{ section.settings.icon_color }};
  }
  
  .smart-features__icon img {
    width: calc({{ section.settings.icon_size }}px * 0.9);
    height: calc({{ section.settings.icon_size }}px * 0.9);
    object-fit: contain;
  }
  
  .smart-features__number {
    font-size: {{ section.settings.number_size }}px;
    font-weight: {{ section.settings.number_weight }};
    color: {{ section.settings.number_color | default: section.settings.accent_color | default: '#ff5a5f' }};
    margin-bottom: 0.5rem;
    line-height: 1;
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
  }
  
  .smart-features__number-suffix {
    font-size: {{ section.settings.number_size }}px;
    font-weight: {{ section.settings.number_weight }};
    color: {{ section.settings.number_color | default: section.settings.accent_color | default: '#ff5a5f' }};
    margin-left: 2px;
  }
  
  .smart-features__title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: {{ section.settings.title_weight }};
    color: {{ section.settings.title_color | default: section.settings.text_color }};
    margin: 0 0 0.75rem;
  }
  
  .smart-features__text {
    font-size: {{ section.settings.text_size }}px;
    color: {{ section.settings.description_color | default: section.settings.text_color }};
    margin: 0;
  }
  .smart-features__text p{
    margin: 0;
  }
{%- endstyle -%}

<div class="smart-features section-{{ section.id }}-padding">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="smart-features__header">
        <h2 class="smart-features__heading">
          {% if section.settings.show_heading_line %}
            <span class="smart-features__heading-line"></span>
          {% endif %}
          {{ section.settings.heading }}
        </h2>
        {% if section.settings.subheading != blank %}
          <div class="smart-features__subheading">{{ section.settings.subheading }}</div>
        {% endif %}
      </div>
    {% endif %}
    
    <div class="smart-features__grid">
      {%- for block in section.blocks -%}
        {% if block.type == 'feature' %}
          <div class="smart-features__item" {{ block.shopify_attributes }}>
            <div class="smart-features__icon-wrapper">
              <div class="smart-features__icon">
                {% if block.settings.custom_icon != blank %}
                  {{ block.settings.custom_icon | image_url: width: 150 | image_tag: loading: 'lazy', alt: block.settings.title }}
                {% elsif block.settings.icon != 'none' %}
                  {% case block.settings.icon %}
                    {% when 'battery' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="18" height="12" rx="2" ry="2"/><line x1="23" y1="13" x2="23" y2="11"/><line x1="4" y1="11" x2="11" y2="11"/></svg>
                    {% when 'safe' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h18v18H3V3z"/><path d="M12 14v-4"/><path d="M8 10h8"/><circle cx="12" cy="10" r="6"/></svg>
                    {% when 'brain' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.96-4.03 3 3 0 0 1 3.8-2.75"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.96-4.03 3 3 0 0 0-3.8-2.75"/></svg>
                    {% when 'lightning' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                    {% when 'gauge' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                    {% when 'shield' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    {% when 'wifi' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
                  {% endcase %}
                {% endif %}
              </div>
            </div>
            
            {% if block.settings.number != blank %}
              <div class="smart-features__number">
                <span data-count-target="{{ block.settings.number }}">0</span>{% if block.settings.number_suffix != blank %}<span class="smart-features__number-suffix">{{ block.settings.number_suffix }}</span>{% endif %}
              </div>
            {% endif %}
            
            {% if block.settings.title != blank %}
              <h3 class="smart-features__title">{{ block.settings.title }}</h3>
            {% endif %}
            
            {% if block.settings.text != blank %}
              <div class="smart-features__text">{{ block.settings.text }}</div>
            {% endif %}
          </div>
        {% endif %}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const counters = document.querySelectorAll('[data-count-target]');
    const options = {
      root: null,
      rootMargin: '0px',
      threshold: 0.1
    };

    // Function to animate counting
    function animateCount(counter, target, duration = 1000) {
      let start = 0;
      const increment = target / (duration / 16); // Update every 16ms (60fps)
      
      function updateCount() {
        start += increment;
        if (start >= target) {
          counter.innerText = target;
          return;
        }
        
        counter.innerText = Math.floor(start);
        requestAnimationFrame(updateCount);
      }
      
      updateCount();
    }
    
    // Initialize the intersection observer
    const observer = new IntersectionObserver(function(entries) {
      entries.forEach(entry => {
        // If the element is in the viewport
        if (entry.isIntersecting) {
          const counter = entry.target;
          const target = parseInt(counter.getAttribute('data-count-target'));
          
          // Start the animation
          animateCount(counter, target, 2000);
          
          // Unobserve after animation starts
          observer.unobserve(counter);
        }
      });
    }, options);

    // Observe all counter elements
    counters.forEach(counter => {
      observer.observe(counter);
    });
  });
</script>

