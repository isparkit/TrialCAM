{% style %}
.image-with-text {
  margin-top: 0;
  margin-bottom: 0;
}

.image-with-text__container {
  /* margin-bottom: 3.2rem; */
}

.image-with-text__media-container {
  position: relative;
}

.image-with-text__media {
  position: relative;
  height: auto;
  width: 100%;
  border-radius: 8px;
  overflow: hidden;
}

.image-with-text__media-image {
  display: block;
  width: 100%;
  height: auto;
  object-fit: cover;
  mix-blend-mode: darken;
}

.image-with-text__content {
  align-items: flex-start;
  display: flex;
  flex-direction: column;
  height: 100%;
  justify-content: center;
  align-self: center;
  margin-top: 0;
}

.image-with-text__subheading {
  margin-bottom: 1rem;
  font-size: 1.6rem;
  color: rgba(var(--color-foreground), 0.7);
}

.section-{{ section.id }}-padding .image-with-text__heading {
  margin-bottom: 1.5rem;
  font-size: 3rem;
  line-height: 1.3;
  color: rgb(var(--color-foreground));
  font-weight: 300;
  font-style: italic;
  margin: 0 0 10px !important;
}

.image-with-text__heading.h0 {
  font-size: 4rem; 
}

.image-with-text__heading.h1 {
  font-size: 3.4rem;
}

.image-with-text__heading.h2 {
  font-size: 2.8rem;
}

.image-with-text__text {
  margin-bottom: 2rem;
  color: rgba(var(--color-foreground), 0.8);
  font-size: 1.5rem;
  line-height: 1.6;
  margin-top: 0 !important;
}

.image-with-text__review {
  margin-top: 2rem;
  margin-bottom: 0;
}

.image-with-text__review-content {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.8rem;
}

.image-with-text__review-stars {
  display: flex;
  align-items: center;
}
.image-with-text__review-stars img{
  width: auto;
  height: 22px;
}

.review-status {
  font-weight: 600;
  font-size: 1.4rem;
}

.review-rating {
  font-weight: 700;
  font-size: 1.4rem;
}

.review-text {
  font-size: 1.4rem;
}

.review-count {
  font-size: 1.4rem;
  opacity: 0.8;
}

.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 1 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 1 | round: 0 }}px;
}

.image-with-text__container {
  display: flex;
  flex-direction: column;
}
.image-with-text .button{
  margin-top: 0 !important;
}
.section-{{ section.id }}-padding .image-with-text__content{
  padding-inline: 4rem;
}

@media screen and (min-width: 750px) {
  

  .image-with-text__container {
    flex-direction: row;
    align-items: center;
    gap: 4rem;
    /* margin-bottom: 5rem; */
  }
  
  .image-with-text__media-container {
    width: 50%;
  }
  
  .image-with-text__content {
    width: 50%;
  }
  
  .image-with-text__container--reverse {
    flex-direction: row-reverse;
  }

  .image-with-text__heading {
    font-size: 3.6rem;
  }

  .image-with-text__heading.h0 {
    font-size: 5rem;
  }

  .image-with-text__heading.h1 {
    font-size: 4.2rem;
  }

  .image-with-text__heading.h2 {
    font-size: 3.2rem;
  }

  .image-with-text__text {
    font-size: 1.6rem;
  }
}

@media screen and (max-width: 749px) {
  .section-{{ section.id }}-padding .image-with-text__content {
    margin-top: 0rem;
    padding-inline: 0rem;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
}
{% endstyle %}

<div class="image-with-text color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="image-with-text__container {% if section.settings.image_alignment == 'right' %}image-with-text__container--reverse{% endif %}">
      <div class="image-with-text__media-container">
        <div class="image-with-text__media">
          {%- if section.settings.image != blank -%}
            <img
              srcset="{%- if section.settings.image.width >= 165 -%}{{ section.settings.image | image_url: width: 165 }} 165w,{%- endif -%}
                {%- if section.settings.image.width >= 360 -%}{{ section.settings.image | image_url: width: 360 }} 360w,{%- endif -%}
                {%- if section.settings.image.width >= 535 -%}{{ section.settings.image | image_url: width: 535 }} 535w,{%- endif -%}
                {%- if section.settings.image.width >= 750 -%}{{ section.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
                {%- if section.settings.image.width >= 1070 -%}{{ section.settings.image | image_url: width: 1070 }} 1070w,{%- endif -%}
                {%- if section.settings.image.width >= 1500 -%}{{ section.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
                {{ section.settings.image | image_url }} {{ section.settings.image.width }}w"
              src="{{ section.settings.image | image_url: width: 1500 }}"
              sizes="(min-width: 1100px) 535px, (min-width: 749px) calc((100vw - 130px) / 2), calc(100vw - 30px)"
              alt="{{ section.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              class="image-with-text__media-image"
            >
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>
      <div class="image-with-text__content">
        {%- if section.settings.subheading != blank -%}
          <div class="image-with-text__subheading rte">{{ section.settings.subheading }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="image-with-text__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="image-with-text__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
        
        {%- if section.settings.button_label != blank -%}
          <a{% if section.settings.button_link == blank %} role="link" aria-disabled="true"{% else %} href="{{ section.settings.button_link }}"{% endif %}
            class="button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
          >
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
        
        {%- if section.settings.show_review -%}
          <div class="image-with-text__review">
            <div class="image-with-text__review-content">
              <span class="review-status">{{ section.settings.review_status }}</span>
              <div class="image-with-text__review-stars">
                <img src="{{ section.settings.review_stars_image | image_url }}" alt="Rating {{ section.settings.review_rating }}" loading="lazy" width="140" height="28">
              </div>
              <span class="review-rating">{{ section.settings.review_rating }}</span>
              <span class="review-text">{{ section.settings.review_text }}</span>
              <span class="review-count">{{ section.settings.review_count }}</span>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with Text Reviews",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "label": "Image alignment"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "default": "<p>Upholstery And Mattress Vacuum Cleaner</p>",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Fjerner Effektivt Op Til 99,9 % Af Bakterier",
      "label": "Heading"
    }, 
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Køb Nu",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "default": false,
      "label": "Use secondary button style"
    },
    {
      "type": "header",
      "content": "Review Settings"
    },
    {
      "type": "checkbox",
      "id": "show_review",
      "default": true,
      "label": "Show review information"
    },
    {
      "type": "text",
      "id": "review_status",
      "default": "Fremragende",
      "label": "Review status text"
    },
    {
      "type": "image_picker",
      "id": "review_stars_image",
      "label": "Review stars image"
    },
    {
      "type": "text",
      "id": "review_rating",
      "default": "4.8/5",
      "label": "Review rating"
    },
    {
      "type": "text",
      "id": "review_text",
      "default": "Bedømt",
      "label": "Review text"
    },
    {
      "type": "text",
      "id": "review_count",
      "default": "Baseret På 400+ Anmeldelser",
      "label": "Review count text"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Padding Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "Padding Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Image with Text Reviews",
      "blocks": [],
      "settings": {
        "image_alignment": "left",
        "heading": "Fjerner Effektivt Op Til 99,9 % Af Bakterier",
        "subheading": "<p>Upholstery And Mattress Vacuum Cleaner – UltraClean Pro UV</p>",
        "button_label": "Køb Nu",
        "show_review": true,
        "review_status": "Fremragende",
        "review_rating": "4.8/5",
        "review_text": "Bedømt",
        "review_count": "Baseret På 400+ Anmeldelser"
      }
    }
  ]
}
{% endschema %} 