      "name": "Feature",
      "limit": 5,
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "options": [
            {
              "value": "svg",
              "label": "Built-in SVG icon"
            },
            {
              "value": "image",
              "label": "Custom image"
            }
          ],
