              "value": "droplet",
              "label": "Droplet"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "circle",
              "label": "Circle"
            }
