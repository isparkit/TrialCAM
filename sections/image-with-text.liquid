<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('.image-with-text');
    if (!section) return;

    // Handle video autoplay for YouTube videos
    const autoplayEnabled = {{ section.settings.enable_video_autoplay | json }};
    if (autoplayEnabled) {
      // For YouTube videos - they should autoplay via the iframe URL parameters
      const youtubeIframes = section.querySelectorAll('iframe.js-youtube');
      youtubeIframes.forEach(iframe => {
        if (iframe.src.indexOf('autoplay=1') === -1) {
          // If autoplay parameter is not already in the URL, add it
          const separator = iframe.src.indexOf('?') !== -1 ? '&' : '?';
          iframe.src += separator + 'autoplay=1&mute=1';
        }
      });
    }

    // Handle video control button clicks
    const videoButtons = section.querySelectorAll('.video-control-button');
    videoButtons.forEach(button => {
      button.addEventListener('click', function() {
        // Hide the button
        this.style.display = 'none';

        // Find and play the associated video
        const container = this.closest('.video-container');
        if (!container) return;

        const video = container.querySelector('video');
        if (video) {
          video.classList.remove('hidden');
          video.play().catch(e => console.error('Error playing video:', e));
        }
      });
    });
  });
</script>

