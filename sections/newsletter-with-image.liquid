{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'newsletter-section.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  
  #Newsletter-{{ section.id }} {
    {% if section.settings.background_image != blank %}
      background-image: url({{ section.settings.background_image | image_url }});
      background-position: {{ section.settings.background_position }};
      background-size: {{ section.settings.background_size }};
      background-repeat: no-repeat;
      position: relative;
    {% elsif section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
    
    {% if section.settings.background_overlay_color != blank and section.settings.background_image != blank %}
      isolation: isolate;
    {% endif %}
  }
  
  {% if section.settings.background_overlay_color != blank and section.settings.background_image != blank %}
    #Newsletter-{{ section.id }}::before {
      content: '';
      position: absolute;
      inset: 0;
      background: {{ section.settings.background_overlay_color }};
      opacity: {{ section.settings.background_overlay_opacity }};
      z-index: -1;
    }
  {% endif %}
  
  #Newsletter-{{ section.id }} .newsletter__wrapper {
    {% if section.settings.full_width == false %}
      width: 100%;
      max-width: {{ section.settings.content_width }}px;
      margin-left: auto;
      margin-right: auto;
    {% endif %}
    padding: {{ section.settings.content_padding }}px;
    {% if section.settings.content_background != blank %}
      background-color: {{ section.settings.content_background }};
    {% endif %}
    {% if section.settings.content_border_radius > 0 %}
      border-radius: {{ section.settings.content_border_radius }}px;
    {% endif %}
    {% if section.settings.content_box_shadow %}
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    {% endif %}
  }
  
  #Newsletter-{{ section.id }} .newsletter__heading {
    margin-bottom: {{ section.settings.heading_spacing }}px;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    {% if section.settings.heading_color != blank %}
      color: {{ section.settings.heading_color }};
    {% endif %}
  }
  
  #Newsletter-{{ section.id }} .newsletter__text {
    margin-bottom: {{ section.settings.text_spacing }}px;
    font-size: {{ section.settings.text_size }}px;
    {% if section.settings.text_color != blank %}
      color: {{ section.settings.text_color }};
    {% endif %}
  }
  
  #Newsletter-{{ section.id }} .field__input {
    {% if section.settings.input_background != blank %}
      background-color: {{ section.settings.input_background }};
    {% endif %}
    {% if section.settings.input_text_color != blank %}
      color: {{ section.settings.input_text_color }};
    {% endif %}
    {% if section.settings.input_border_color != blank %}
      border-color: {{ section.settings.input_border_color }};
    {% endif %}
    border-width: {{ section.settings.input_border_width }}px;
    border-radius: {{ section.settings.input_border_radius }}px;
    padding: {{ section.settings.input_padding }}px;
    height: auto;
  }
  
  #Newsletter-{{ section.id }} .field__input::placeholder {
    {% if section.settings.input_placeholder_color != blank %}
      color: {{ section.settings.input_placeholder_color }};
    {% endif %}
  }
  
  #Newsletter-{{ section.id }} .newsletter-form__button {
    {% if section.settings.button_background != blank %}
      background-color: {{ section.settings.button_background }};
    {% endif %}
    {% if section.settings.button_text_color != blank %}
      color: {{ section.settings.button_text_color }};
    {% endif %}
    border-radius: {{ section.settings.button_border_radius }}px;
    font-weight: {{ section.settings.button_weight }};
    padding: {{ section.settings.button_padding }}px;
  }
  
  #Newsletter-{{ section.id }} .newsletter-form__button:hover {
    {% if section.settings.button_background_hover != blank %}
      background-color: {{ section.settings.button_background_hover }};
    {% endif %}
    {% if section.settings.button_text_color_hover != blank %}
      color: {{ section.settings.button_text_color_hover }};
    {% endif %}
  }
{%- endstyle -%}

<div class="newsletter color-{{ section.settings.color_scheme }} isolate{% if section.settings.full_width %} newsletter--full-width{% endif %}">
  <div class="newsletter__wrapper section-{{ section.id }}-padding" id="Newsletter-{{ section.id }}">
    <div class="newsletter__content {% if section.settings.horizontal_alignment == 'center' %}center{% elsif section.settings.horizontal_alignment == 'right' %}right{% else %}left{% endif %}-aligned {% if section.settings.vertical_alignment == 'center' %}vertical-center{% elsif section.settings.vertical_alignment == 'bottom' %}vertical-bottom{% else %}vertical-top{% endif %}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2 class="newsletter__heading {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
              {{ block.settings.heading | escape }}
            </h2>
          {%- when 'paragraph' -%}
            <div class="newsletter__text rte" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {%- when 'email_form' -%}
            <div {{ block.shopify_attributes }}>
              {% form 'customer', class: 'newsletter-form' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="newsletter-form__field-wrapper">
                  <div class="field">
                    <input
                      id="NewsletterForm--{{ section.id }}"
                      type="email"
                      name="contact[email]"
                      class="field__input"
                      value="{{ form.email }}"
                      aria-required="true"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      {% if form.errors %}
                        autofocus
                        aria-invalid="true"
                        aria-describedby="Newsletter-error--{{ section.id }}"
                      {% elsif form.posted_successfully? %}
                        aria-describedby="Newsletter-success--{{ section.id }}"
                      {% endif %}
                      placeholder="{{ section.settings.input_placeholder | escape }}"
                      required
                    >
                    <label class="field__label" for="NewsletterForm--{{ section.id }}">
                      {{ section.settings.input_placeholder | escape }}
                    </label>
                  </div>
                  {%- if form.errors -%}
                    <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}">
                      {%- for error in form.errors -%}
                        <span>{{ error }}</span>
                      {%- endfor -%}
                    </small>
                  {%- endif -%}
                </div>
                <button type="submit" class="newsletter-form__button button" name="commit">
                  {{ section.settings.button_label | escape }}
                </button>
                {%- if form.posted_successfully? -%}
                  <h3 class="newsletter-form__message newsletter-form__message--success" id="Newsletter-success--{{ section.id }}" tabindex="-1" autofocus>
                    {{ section.settings.success_text | escape }}
                  </h3>
                {%- endif -%}
              {% endform %}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

