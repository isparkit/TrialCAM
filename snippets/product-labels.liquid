{% liquid
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
%}
{% capture defaultbadges %}
  {%- if on_sale and product.available and discount -%}
    <div class="saved_tag color-{{ settings.sale_badge_color_scheme }} grid-product__tag grid-product__tag--sale">
      {% capture saved_amount %}{{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}%{% endcapture %}
      {{ 'general.save_html' | t: saved_amount: saved_amount }}
    </div>
  {%- endif -%}
{% endcapture %}

{% assign left_lebels = '' %}
{% assign right_lebels = '' %}
{% if product.metafields.custom.product_labels and product.metafields.custom.product_labels.value.count > 0 %}
  
  {% for label in product.metafields.custom.product_labels.value %}
    {% assign alignment = label.alignment.value.label | downcase %}
    {% if alignment == 'left' %}
      {% capture left_lebel %}
        <span class="custom-badge" style="background:{{ label.background_color }}; color:{{ label.text_color }}; border:1px solid {{ label.border_color }};">{{ label.label }}</span>
      {% endcapture %}
      {% assign left_lebels = left_lebels | append:left_lebel %}
    {% endif %}
    {% if alignment == 'right' %}
      {% capture right_lebel %}
        <span class="custom-badge" style="background:{{ label.background_color }}; color:{{ label.text_color }}; border:1px solid {{ label.border_color }};">{{ label.label }}</span>
      {% endcapture %}
      {% assign right_lebels = right_lebels | append:right_lebel %}
    {% endif %}
  {% endfor %}
{% endif %}
{% if left_lebels != blank or right_lebels != blank or defaultbadges != blank %}
  <div class="custom-badges">
    {% if left_lebels != blank %}
      <div class="custom-badges-left">{{ left_lebels }}</div>
    {% endif %}
    {% if right_lebels != blank or defaultbadges != blank %}
      <div class="custom-badges-right">{{ defaultbadges }}{{ right_lebels }}</div>
    {% endif %}
  </div>
{% endif %}