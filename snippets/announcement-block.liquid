{% comment %}
  Renders a single announcement block

  Accepts:
  - block: {Object} The block object containing settings
  - index: {Number} The block index
{% endcomment %}

<div class="announcement-block" {{ block.shopify_attributes }}>
  {% if block.settings.icon_svg != blank %}
    <div class="announcement-block__icon">
      {{ block.settings.icon_svg }}
    </div>
  {% elsif block.settings.icon != blank %}
    <div class="announcement-block__icon">
      {% render 'icon', icon: block.settings.icon %}
    </div>
  {% endif %}
  <div class="announcement-block__text">
    <h6>{{ block.settings.text }}</h6>
  </div>
</div>

<style>
  .custom-announcement-section .announcement-block__text h6 {
    font-size: 16px;
    font-weight: 400;
    font-family: 'Roboto';
    line-height: 1em;
    letter-spacing: 5px;
    margin: 0px !important;
    color: #ffff !important;
  }
  .custom-announcement-section .announcement-block {
    gap: 10px;
  }
  .custom-announcement-section .announcement-block__icon {
    margin: 0;
  }
  .custom-announcement-section .announcement-block__icon a {
    line-height: 0 !important;
  }
  .custom-announcement-section .announcement-block__text {
    font-family: 'Roboto';
    font-size: 14px;
    letter-spacing: 0;
    font-weight: 400;
    line-height: 1em;
  }
  .custom-announcement-section .announcement-block {
    padding: 0;
    height: 49px;
  }

  @media screen and (min-width: 1441px) {
    .custom-announcement-section .announcement-block__text {
      font-size: 16px !important;
    }
  }
</style>
