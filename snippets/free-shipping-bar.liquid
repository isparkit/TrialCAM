{% assign shipping_bar_threshold = settings.shipping_bar_threshold | times : 100 %}
<div class="free-shipping-progress">
  <p class="free-shipping-message">
    {% if cart.total_price >= shipping_bar_threshold %}
      {{ 'general.free_shipping_message' | t }}
    {% else %}
      {% assign jjamount = shipping_bar_threshold | minus: cart.total_price  %}
      {% assign jjamount = jjamount | money  %}
      {{ 'general.free_shipping_message_charge_html' | t: amount: jjamount }}
    {% endif %}
  </p>
  <div class="progress-bar">
    <div class="progress-fill" style="width: {{ cart.total_price | times: 100 | divided_by: shipping_bar_threshold }}%;">&nbsp:;</div>
  </div>
</div>

{% style %}
  .free-shipping-progress {
  margin: 15px 0;
}

.free-shipping-message {
  font-size: 14px;
  margin-bottom: 5px;
}

.progress-bar {
  width: 100%;
  height: 8px;
  background-color: #eee;
  border-radius: 4px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: #4caf50;
  width: 0%;
  transition: width 0.4s ease;
}

{% endstyle %}