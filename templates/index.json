        "review_JNKwUd": {
          "type": "review",
          "settings": {
            "title": "Perfekt til allergikere",
            "review": "<p>Jeg lider af stovallergy, og siden jeg begyndte at bruge denne støvsuger, har jeg mærket en stor forskel. HEPA-filtret gør underværker. Kan varmt anbefales!</p>",
            "name": "Anders Nielsen"
          }
        },
        "review_E67UdQ": {
          "type": "review",
          "settings": {
            "title": "Overraskende kraftfuld!",
            "review": "<p>Tænkte ikke, at en håndholdt støvsuger kunne være så effektiv. Den fjernede alt fra dyrehår til dybliggende støv i madrassen. Plus, den ser også flot ud.</p>",
            "name": "Louise Petersen"
          }
        }
      },
